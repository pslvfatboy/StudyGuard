<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <TextView
        android:text="StudyGuard setup"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Parent PIN (used to unlock settings / allow uninstall)"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <EditText
        android:id="@+id/setupPinInput"
        android:inputType="numberPassword"
        android:hint="e.g. 4821"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Blocklist URL (raw GitHub file, one package name per line)"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <EditText
        android:id="@+id/setupUrlInput"
        android:hint="https://raw.githubusercontent.com/you/studyguard-list/main/blocklist.txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/saveButton"
        android:text="Save PIN + URL"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#CCCCCC" android:layout_marginVertical="20dp" />

    <Button
        android:id="@+id/deviceAdminButton"
        android:text="1. Grant Device Admin"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/accessibilityButton"
        android:text="2. Enable StudyGuard Accessibility Service"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/overlayButton"
        android:text="3. Grant 'Draw over other apps'"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/startServiceButton"
        android:text="4. Start StudyGuard"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/statusText"
        android:text="Not started"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
</ScrollView>
